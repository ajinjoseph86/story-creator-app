KIE_API_KEY=your_kie_ai_api_key_here
DAILY_BUDGET_USD=30.00
PORT=3000

# Shared password gate — set this to restrict who can access the app.
# Leave unset to disable the login gate entirely.
APP_PASSWORD=your_chosen_password_here
# Random secret used to sign the login session cookie — any long random string.
SESSION_SECRET=change_this_to_a_random_string

# Admin password (sees every creation). The older APP_PASSWORD still works as the admin password.
ADMIN_PASSWORD=your_admin_password_here
# People with their own login and a total spending allowance in USD, as name:password:allowance, separated by ;
# They only see their own creations; once their allowance is spent they can view/download but not create.
APP_USERS=maria:her-password:20;john:his-password:15
